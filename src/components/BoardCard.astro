---
/**
 * BoardCard — a board, by reference designator.
 *
 * Chamfered corner via clip-path polygon(14px 0, 100% 0, 100% 100%, 0 100%,
 * 0 14px) plus border-radius 6px. Left padding 62px clears the trace.
 *
 * Hover: border --rule -> --rule-2, the trace pulses, the via lights. The
 * card does not lift, scale or shadow (component inventory 2.2).
 */
import Chip from './Chip.astro';
import TraceVia from './TraceVia.astro';

interface Props {
  designator: string;
  title: string;
  role: string;
  status?: { label: string; kind: 'released' | 'progress' };
  specs?: string[];
  /** Subset of `specs` the 390 artboard keeps; others hide below 900px. */
  specsMobile?: string[];
  standards?: string[];
  /** Subset of `standards` the 390 artboard keeps. Usually none. */
  standardsMobile?: string[];
  /** Adds the dashed client-confidential chip. */
  confidential?: boolean;
  /** Draws the hazard mark — a mains-connected board. */
  mains?: boolean;
  /** Not yet fabricated: dashed trace and dashed via. */
  unfabricated?: boolean;
  href?: string;
  /** Capability facets, printed as the card's footer line. Sheet 3 only. */
  capabilities?: string[];
  /**
   * Sheet 3's card. The index argues breadth, so each card carries less:
   * the head takes ONE secondary chip, the standards row is dropped, and
   * the capability footer is added. The full chip set belongs on the case
   * study, where there is room to mean something.
   */
  index?: boolean;
  /** The index's secondary head chip. Ignored when `confidential`. */
  indexChip?: string;
  /** U5 only: spans both columns and carries the milestone panel (§2.2). */
  featured?: boolean;
  milestone?: { label: string; value: string };
  compact?: boolean;
  /** Designed card height; trace-fit.js re-fits to the real height. */
  traceHeight?: number;
  class?: string;
}
const {
  designator, title, role, status, specs = [], standards = [],
  specsMobile, standardsMobile,
  confidential = false, mains = false, unfabricated = false,
  href, capabilities = [], index = false, indexChip, featured = false, milestone,
  compact = false,
  // The featured card is one row of content, not a column of it, so its
  // trace is short. trace-fit.js re-fits all of them to the real height.
  traceHeight = featured ? 150 : compact ? 170 : 296,
  class: className
} = Astro.props;

const Tag = href ? 'a' : 'div';
/** A chip not named in the mobile subset is hidden, never duplicated. */
const desktopOnly = (label: string, subset?: string[]) =>
  subset !== undefined && !subset.includes(label);

const CONFIDENTIAL_NOTE = compact
  ? 'Client confidential'
  : 'Client confidential — reasoning published, design not';
---

<Tag
  class:list={[
    'board-card',
    {
      'board-card--compact': compact,
      'board-card--index': index,
      'board-card--featured': featured
    },
    className
  ]}
  data-trace-host
  data-capabilities={capabilities.join('|')}
  href={href}
>
  <TraceVia
    height={traceHeight}
    compact={compact}
    state={unfabricated ? 'unfabricated' : 'rest'}
  />

  <div class="board-card__body">
  <div class="board-card__head">
    <span class="board-card__designator">{designator}</span>
    {status && (
      <Chip variant={status.kind === 'released' ? 'status-released' : 'status-progress'}>
        {status.label}
      </Chip>
    )}
    {index && (confidential || indexChip) && (
      <Chip variant={confidential ? 'confidential' : 'standard'}>
        {confidential ? 'Confidential' : indexChip}
      </Chip>
    )}
    {mains && !index && (
      <svg class="board-card__mains" width="16" height="14" viewBox="0 0 16 14"
           role="img" aria-label="Mains-connected board">
        <path d="M8 1.5 L15 12.5 H1 Z" fill="none" stroke="var(--live)" stroke-width="1.25" />
        <path d="M8.6 5 L6.6 8.2 H8.2 L7.4 10.6 L9.4 7.4 H7.8 Z" fill="var(--live)" />
      </svg>
    )}
  </div>

  <h3 class="board-card__title">{title}</h3>
  <p class="board-card__role">{role}</p>

  {specs.length > 0 && (
    <div class="board-card__chips board-card__chips--specs">
      {specs.map((s) => (
        <Chip variant="spec" class={desktopOnly(s, specsMobile) ? 'is-wide-only' : undefined}>
          {s}
        </Chip>
      ))}
    </div>
  )}

  {!index && (standards.length > 0 || confidential) && (
    <div class="board-card__chips board-card__chips--standards">
      {standards.map((s) => (
        <Chip variant="standard" class={desktopOnly(s, standardsMobile) ? 'is-wide-only' : undefined}>
          {s}
        </Chip>
      ))}
      {confidential && <Chip variant="confidential">{CONFIDENTIAL_NOTE}</Chip>}
    </div>
  )}

  {capabilities.length > 0 && (
    <p class="board-card__capabilities">{capabilities.join(' · ')}</p>
  )}
  </div>

  {milestone && (
    <div class="board-card__milestone">
      <span class="board-card__milestone-label">{milestone.label}</span>
      <span class="board-card__milestone-value">{milestone.value}</span>
    </div>
  )}

  <slot />
</Tag>

<style>
  .board-card {
    position: relative;
    display: block;
    min-height: 296px;
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: var(--r-board);
    clip-path: polygon(14px 0, 100% 0, 100% 100%, 0 100%, 0 14px);
    padding: 24px 28px 24px 62px;   /* 62px left clears the trace */
    color: inherit;
    text-decoration: none;
    transition: border-color var(--d-slow) var(--e-probe);
  }

  /* Border tone only. Nothing moves. */
  .board-card:hover,
  .board-card:focus-within { border-color: var(--rule-2); }

  .board-card__head {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .board-card__designator {
    font-family: var(--f-data);
    font-size: 13px;
    color: var(--silk-faint);
  }

  .board-card__mains { margin-left: 2px; align-self: center; }

  .board-card__title {
    margin: 14px 0 6px;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .board-card__role {
    font-size: 14px;
    color: var(--silk-dim);
  }

  .board-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .board-card__chips--specs { margin-top: 20px; }
  .board-card__chips--standards { margin-top: 12px; }

  /* The capability footer, sheet 3. These are the same words the filter
     chips carry, so pressing "Embedded" shows exactly the cards that print
     "Embedded" here — the list is the legend for the filter. */
  .board-card__capabilities {
    margin-top: 18px;
    font-family: var(--f-data);
    font-size: 11px;
    color: var(--silk-faint);
  }

  /* U5: spans both columns, and the milestone sits beside the body rather
     than under it. Amber border because the board is not fabricated — the
     same signal the dashed trace carries (§9.1). */
  /* The index card is shorter than the home card because it carries fewer
     rows. Letting content set the height keeps both columns honest; the
     grid still stretches the pair in a row to match. */
  .board-card--index { min-height: 0; }

  .board-card--featured {
    grid-column: 1 / -1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: var(--gutter);
    align-items: start;
    border-color: rgb(242 169 59 / 0.35);
  }

  .board-card--featured:hover,
  .board-card--featured:focus-within { border-color: rgb(242 169 59 / 0.55); }

  .board-card__milestone {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 2px;
  }

  .board-card__milestone-label {
    font-size: 12px;
    color: var(--silk-faint);
  }

  .board-card__milestone-value {
    font-family: var(--f-data);
    font-size: 13px;
    line-height: 1.45;
    color: var(--silk);
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    /* Nothing is beside anything at 390. */
    .board-card--featured {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
    .board-card__capabilities { margin-top: 14px; }
  }

  /* 390 artboard */
  .board-card--compact,
  :global(.stack--mobile) .board-card {
    min-height: 0;
    padding: 18px 18px 18px 46px;
  }

  .board-card--compact .board-card__head { gap: 10px; }
  .board-card--compact .board-card__designator { font-size: 12px; }
  .board-card--compact .board-card__title { margin: 10px 0 4px; font-size: 18px; line-height: 1.25; }
  .board-card--compact .board-card__role { font-size: 13px; }
  .board-card--compact .board-card__chips--specs { margin-top: 12px; gap: 6px; }
  .board-card--compact .board-card__chips--standards { margin-top: 6px; gap: 6px; }

  @media (max-width: 900px) {
    .board-card {
      min-height: 0;
      padding: 18px 18px 18px 46px;
    }

    .board-card :global(.is-wide-only) { display: none; }
    .board-card__title { margin: 10px 0 4px; font-size: 18px; line-height: 1.25; }
    .board-card__role { font-size: 13px; }
    .board-card__chips--specs { margin-top: 12px; gap: 6px; }
    .board-card__chips--standards { margin-top: 6px; gap: 6px; }
  }
</style>
